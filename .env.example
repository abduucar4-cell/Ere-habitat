# URL publique du site (sans slash final). Obligatoire en production.
NEXT_PUBLIC_SITE_URL=https://www.ere-habitat.com

# Google Search Console : jeton de vérification "balise HTML" (facultatif si vérification DNS)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Tag Manager (chargé uniquement après consentement "mesure d'audience")
NEXT_PUBLIC_GTM_ID=

# --- Notifications des demandes de devis (au moins une méthode en production) ---
# 1) Webhook (Make, Zapier, n8n, CRM...) : reçoit un POST JSON par demande
LEAD_WEBHOOK_URL=
# Secret envoyé dans l'en-tête X-Lead-Signature (HMAC SHA-256 du corps)
LEAD_WEBHOOK_SECRET=

# 2) E-mail via l'API Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=ERE Habitat <devis@ere-habitat.com>
